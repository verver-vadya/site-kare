---
// Фото из public/assets/img в нескольких ширинах. sizes — какой ширины фото на экране.
import { images } from "../data/images";
import { url } from "../lib/url";
interface Props { name: string; alt: string; sizes: string; class?: string; eager?: boolean }
const { name, alt, sizes, class: className, eager = false } = Astro.props;
const meta = images[name];
if (!meta) throw new Error(`Нет фото ${name}`);
const file = (w: number) => url(`/assets/img/${name}-${w}.webp`);
---
<img
  class={className}
  src={file(meta.widths[0])}
  srcset={meta.widths.map((w) => `${file(w)} ${w}w`).join(", ")}
  sizes={sizes}
  width={meta.w}
  height={meta.h}
  alt={alt}
  loading={eager ? "eager" : "lazy"}
  decoding={eager ? "auto" : "async"}
  fetchpriority={eager ? "high" : undefined}
/>
