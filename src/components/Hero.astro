---
// Первый экран главной: интерьер салона. После загрузки фото включается лампа на стене слева:
// светится край абажура, вниз по стене уходит конус света, и вся комната становится теплее.
// Свет — SVG в координатах фото (viewBox = размер кадра), preserveAspectRatio повторяет object-fit/object-position,
// поэтому свет всегда лежит на той же лампе. Слои света кладутся режимом screen, тепло комнаты — overlay.
// Включение: main.js ставит класс is-ready, анимация lamp-on в global.css. Лампа есть только в широком кадре,
// в вертикальном (телефон) её не видно, там остаётся просто фото.
import { images } from "../data/images";
import { url } from "../lib/url";

const L = images["hero-l"], P = images["hero-p"];
const k = L.w / 4000; // координаты ниже — в исходном кадре 4000×2667
// Абажур: края раструба и направление оси вниз-вправо
const lamp = { a: [1203, 979], b: [1429, 917], m: [1316, 948], axis: [0.28, 0.96] };
const along = (d: number, side = 0) => {
  const [ax, ay] = lamp.axis, [px, py] = [ay, -ax];
  return [lamp.m[0] + ax * d + px * side, lamp.m[1] + ay * d + py * side];
};
const pt = (p: number[]) => p.map((v) => v.toFixed(0)).join(" ");
const beam = [lamp.a, lamp.b, along(1150, 700), along(1150, -700)].map(pt).join(" ");
const tilt = (Math.atan2(lamp.b[1] - lamp.a[1], lamp.b[0] - lamp.a[0]) * 180) / Math.PI;
const set = (key: string, widths: number[]) => widths.map((w) => `${url(`/assets/img/${key}-${w}.webp`)} ${w}w`).join(", ");
---
<div class="hero__stage">
  <picture>
    <source media="(max-aspect-ratio: 1/1)" srcset={set("hero-p", P.widths)} sizes="100vw" width={P.w} height={P.h}>
    <img src={url("/assets/img/hero-l-1920.webp")} srcset={set("hero-l", L.widths)} sizes="(min-aspect-ratio: 3/2) 100vw, 150svh"
      width={L.w} height={L.h} alt="Зал салона: кирпичная стена, полка с растениями, диван с белыми подушками и лампа на стене" fetchpriority="high">
  </picture>
  <svg class="hero__lamp hero__room lamp-light" viewBox={`0 0 ${L.w} ${L.h}`} preserveAspectRatio="xMaxYMid slice" aria-hidden="true" focusable="false">
    <radialGradient id="room" gradientUnits="userSpaceOnUse" cx={lamp.m[0] * k} cy={(lamp.m[1] + 500) * k} r={2600 * k}>
      <stop offset="0" stop-color="#ff8a1f" stop-opacity="0.55" />
      <stop offset="0.35" stop-color="#ff8a1f" stop-opacity="0.38" />
      <stop offset="1" stop-color="#ff8a1f" stop-opacity="0.12" />
    </radialGradient>
    <rect width={L.w} height={L.h} fill="url(#room)" />
  </svg>
  <svg class="hero__lamp hero__light lamp-light" viewBox={`0 0 ${L.w} ${L.h}`} preserveAspectRatio="xMaxYMid slice" aria-hidden="true" focusable="false">
    <defs>
      <filter id="lamp-wide" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="55" /></filter>
      <filter id="lamp-mid" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="22" /></filter>
      <filter id="lamp-fine" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="4" /></filter>
      <linearGradient id="beam" gradientUnits="userSpaceOnUse" x1={lamp.m[0]} y1={lamp.m[1]} x2={along(1150)[0]} y2={along(1150)[1]}>
        <stop offset="0" stop-color="#ffd59a" stop-opacity="0.95" />
        <stop offset="0.45" stop-color="#ffb866" stop-opacity="0.4" />
        <stop offset="1" stop-color="#ff9a40" stop-opacity="0" />
      </linearGradient>
      <radialGradient id="pool">
        <stop offset="0" stop-color="#ffcf8f" stop-opacity="0.95" />
        <stop offset="0.6" stop-color="#ffa95a" stop-opacity="0.35" />
        <stop offset="1" stop-color="#ff9a40" stop-opacity="0" />
      </radialGradient>
    </defs>
    <g transform={`scale(${k})`}>
      <polygon points={beam} fill="url(#beam)" filter="url(#lamp-wide)" />
      <ellipse cx={along(330)[0]} cy={along(330)[1]} rx="430" ry="560" transform={`rotate(${tilt} ${pt(along(330))})`} fill="url(#pool)" filter="url(#lamp-mid)" />
      <ellipse cx={lamp.m[0]} cy={lamp.m[1] + 6} rx="150" ry="55" transform={`rotate(${tilt} ${pt(lamp.m)})`} fill="#ffb25c" fill-opacity="0.85" filter="url(#lamp-mid)" />
      <ellipse cx={lamp.m[0]} cy={lamp.m[1] + 4} rx="108" ry="17" transform={`rotate(${tilt} ${pt(lamp.m)})`} fill="#fff1d6" filter="url(#lamp-fine)" />
    </g>
  </svg>
</div>
